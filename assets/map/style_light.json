{
 "version": 8,
 "name": "Yo Voy Go — light",
 "sources": {
  "openmaptiles": {
   "type": "vector",
   "url": "https://tiles.openfreemap.org/planet",
   "attribution": "© OpenMapTiles © OpenStreetMap"
  }
 },
 "layers": [
  {
   "id": "background",
   "type": "background",
   "paint": {
    "background-color": "#F5F6FA"
   }
  },
  {
   "id": "park",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "park",
   "paint": {
    "fill-color": "#E9EDEA"
   }
  },
  {
   "id": "landcover-grass",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "landcover",
   "filter": [
    "in",
    "class",
    "grass",
    "wood"
   ],
   "paint": {
    "fill-color": "#E9EDEA"
   }
  },
  {
   "id": "water",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "water",
   "paint": {
    "fill-color": "#DADDEB"
   }
  },
  {
   "id": "waterway",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "waterway",
   "minzoom": 12,
   "paint": {
    "line-color": "#DADDEB",
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.4
     ],
     [
      "zoom"
     ],
     12,
     0.5,
     18,
     3
    ]
   }
  },
